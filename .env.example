# Vorlage. Echte Werte in .env (steht in .gitignore).

# Auf welchem Port der Gateway lauscht. Railway setzt PORT selbst.
PORT=8080

# Basis-URL des Python-Backends fuer Strecke B (ohne Slash am Ende).
# Lokal: http://127.0.0.1:8000
# Railway: die INTERNE Adresse (*.railway.internal), nicht die oeffentliche.
BACKEND_URL=http://127.0.0.1:8000

# Muss exakt WS_INTERNAL_SECRET im Backend entsprechen.
WS_INTERNAL_SECRET=

# Muss exakt SECRET_KEY im Backend entsprechen (gleicher JWT, gleiche Signatur).
SECRET_KEY=
ALGORITHM=HS256

# Dasselbe Redis wie das Backend.
REDIS_URL=

# Optional. Leer lassen -> wird aus Hostname + Zufall gebaut.
INSTANCE_ID=
